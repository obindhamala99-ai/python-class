'''
- It will have multiple independent classes with same function name and arguments
- All classes object must be executed using independent function

- A function with many forms is polymorshim
'''


class Esewa:
    def pay(self, send_from, send_to, amount):
        print (f'Rs.{amount} has been withdrawn using Esewa from {send_from} to {send_to}.')

class Khalti:
    def pay(self, send_from, send_to, amount):
        print (f'Rs.{amount} has been withdrawn using Khalti from {send_from} to {send_to}.')

class Fonepay:
    def pay(self, send_from, send_to, amount):
         print (f'Rs.{amount} has been withdrawn using Fonepay from {send_from} to {send_to}.')

                
        
        


def payment(obj, send_from, send_to, amount):
    obj.pay(send_from, send_to, amount)


'''
-Function Overloading - same function, same argument, Different Values
'''


payment(Fonepay(), 'Ram', 'shyam', 500)





'''
- Abstraction -> Data hiding and implementation hiding
- To use abstraction conceot parent class must be an abstract class.
- If we create an abstract class there must be atleast one abstract function.

- If normal class -> Inheritance
- If abstract class -> Implements
'''


# abstract base class
from abc import ABC, abstractmethod


class MobileBanking(ABC):
    @abstractmethod
    def userDetails(self):
        pass


class NabilBankMobileBanking(MobileBanking):
    def connection(self):
        print('Connected to Nabil Bank Database Server...')

    def userDetails(self):
        print(f'A/C No.: 1234567890\nBalance: Rs.60000')


nb = NabilBankMobileBanking()


nb.connection()


nb.userDetails()


# Create a polymorphism program for sending message.
'''
user can send message using four different platforms:
1 Messenger
2 Viber
3 Whatsapp
4 Instagram

- Message through these classes must be sent using one single function send_message().
-Function should accept these agruments:
- Sender
- receiver
- message

-program should show output as:
-{Receiver_name} received a message
-{sender_name} sent you a message
- Message: {message}

'''


class Messenger:
    def message(self, sender_name, receiver_name, message):
         print (f'{receiver_name} received a message  using Messenger from {sender_name} to {receiver_name}.')

class Viber:
    def message(self, sender_name, receiver_name, message):
        print (f'{sender_name} sent you a message  using Viber from {sender_name} to {receiver_name}.')

class Whatsapp:
    def message(self, sender_name, receiver_name, message):
        print (f'{message} sent you a message  using Whatsapp from {sender_name} to {receiver_name}.')
        
class Instagram:
     def message(self, sender_name, receiver_name, message):
          print (f'{message} sent you a message  using Whatsapp from {sender_name} to {receiver_name}.')
        
    
        
        


def sendmesaage(obj, sender_name, receiver_name, message):
    obj.message(sender_name, receiver_name, message)


sendmesaage(Viber(), 'obin', 'pujan', 'hello')



